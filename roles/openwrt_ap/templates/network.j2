
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
{% for port in lan_ports %}
	list ports '{{ port }}'
{% endfor %}

config bridge-vlan
	option device 'br-lan'
	option vlan '1'
{% for port in lan_ports %}
	list ports '{{ port }}:u*'
{% endfor %}

config bridge-vlan
	option device 'br-lan'
	option vlan '{{ guest_vid }}'
{% for port in guest_trunk_ports %}
	list ports '{{ port }}:t'
{% endfor %}

config interface 'lan'
	option device 'br-lan.1'
	option proto 'dhcp'

config interface 'guest'
	option device 'br-lan.{{ guest_vid }}'
{% if guest_gateway %}
	option proto 'static'
	option ipaddr '{{ guest_ipaddr }}'
	option netmask '255.255.255.0'
{% else %}
	option proto 'none'
{% endif %}
